# LLM — enable exactly one backend unless you set LLM_PROVIDER (gemini | openai | ollama)
USE_OPENAI=false
OPENAI_API_KEY=

USE_GEMINI=false
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

USE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=600
# Optional token budgets for batched vs single-article digest fallback (Ollama)
# OLLAMA_DIGEST_BATCH_MAX_TOKENS=12288
# OLLAMA_DIGEST_SINGLE_MAX_TOKENS=2048
# LLM_PROVIDER=ollama

# Fewer API calls on Gemini/OpenAI/Ollama: digest many articles per request (free Gemini tier is tiny per-day)
DIGEST_LLM_BATCH_SIZE=8
DIGEST_BATCH_CONTENT_CHARS=3500

# Curator (ranking for email): defaults favor Ollama — cap items + short summaries avoid 10min+ timeouts
# CURATOR_LLM_MAX_DIGESTS=12
# CURATOR_LLM_MAX_DIGESTS=none
# CURATOR_PROMPT_SUMMARY_CHARS=480
# OLLAMA_CURATOR_MAX_TOKENS=6144

MY_EMAIL=
APP_PASSWORD=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
